
# FinSentinel environment configuration template.
# Copy to .env and fill in values before deployment.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment: development | test | production
# Controls whether synthetic detection thresholds are allowed at startup.
ENVIRONMENT=production

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL connection (required in all non-test environments)
# ---------------------------------------------------------------------------

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# ---------------------------------------------------------------------------
# Security: operator authentication
# ---------------------------------------------------------------------------

# Secret token used to authenticate operator endpoints (approve/reject updates,
# manage keys and schemas).  Must be a high-entropy random string.
# If unset, all operator-authenticated endpoints return HTTP 503.
FINSENTINEL_OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Ingestion limits
# ---------------------------------------------------------------------------

# Maximum concurrent ingestion requests per uvicorn worker process.
# Recommended: set to (CPU cores * 2) or based on load testing.
FINSENTINEL_MAX_CONCURRENT_INGESTION=10

# Per-source-IP rate limit for POST /updates (requests per minute).
# Applied at the application layer; also set nginx limit_req for cluster-wide enforcement.
FINSENTINEL_INGESTION_RATE_LIMIT_RPM=60

# Maximum seconds allowed to read the request body.
# Set in conjunction with nginx client_body_timeout.
FINSENTINEL_BODY_READ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Audit delivery worker
# ---------------------------------------------------------------------------

# Set to 1, true, or yes to enable the background outbox delivery worker.
# When disabled, audit events accumulate in the outbox but are not forwarded.
FINSENTINEL_AUDIT_DELIVERY_WORKER_ENABLED=1

# Webhook URL to receive audit events (not yet wired; reserved for Sprint 1).
# FINSENTINEL_AUDIT_WEBHOOK_URL=https://your-siem-endpoint/ingest

# ---------------------------------------------------------------------------
# Sample-count trust mode
# ---------------------------------------------------------------------------

# client_claimed (default) — accept sample counts from clients as reported.
# coordinator_verified     — require a trusted coordinator to verify counts;
#                            startup fails if no provider is configured.
FINSENTINEL_SAMPLE_COUNT_TRUST_MODE=client_claimed

# ---------------------------------------------------------------------------
# Detection thresholds (production — required when ENVIRONMENT=production)
# ---------------------------------------------------------------------------

# All thresholds must be set when ENVIRONMENT=production.
# Values must be calibrated against representative clean updates.

FINSENTINEL_MAX_WEIGHT_L2_NORM=
FINSENTINEL_MAX_WEIGHT_ABS_MEAN=
FINSENTINEL_MAX_WEIGHT_STD=
FINSENTINEL_MAX_WEIGHT_ZERO_FRACTION=
FINSENTINEL_MIN_WEIGHT_ZERO_FRACTION=

# Action taken when a high or critical anomaly is detected.
# pending_approval | quarantined  (default: quarantined)
FINSENTINEL_HIGH_RISK_ACTION=quarantined

# ---------------------------------------------------------------------------
# Development / test only (do not set in production)
# ---------------------------------------------------------------------------

# Set to 1 to enable PostgreSQL concurrent outbox tests (requires PG_MIGRATION_TEST_PASSWORD).
# FINSENTINEL_POSTGRES_TEST=1

# Password for the finsentinel_migration_test PostgreSQL role.
# PG_MIGRATION_TEST_PASSWORD=
FINSENTINEL_OPERATOR_TOKEN=
