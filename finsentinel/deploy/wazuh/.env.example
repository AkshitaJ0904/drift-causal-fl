# Wazuh stock default credentials, for localhost-only demos. Change them for any real deployment.
# Copied by setup-wsl.sh to ~/finsentinel-wazuh/.env (OUTSIDE the repo, chmod 600).
# NEVER place the real .env inside the repo directory.
#
# LOCAL DEV ONLY. The Wazuh values below are the official wazuh-docker 4.8.2
# single-node defaults. They MUST match config/wazuh_indexer/internal_users.yml
# (bcrypt hash of the admin password) and config/wazuh_dashboard/wazuh.yml
# (API password). Changing them here alone breaks login. All ports are bound to
# 127.0.0.1 in docker-compose.yml, so the stack is not reachable from the network.
# Before any shared deployment, follow the official Wazuh password-change procedure.

# Wazuh Indexer (OpenSearch) admin - used by indexer, manager (Filebeat), dashboard
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Wazuh API user - used by dashboard -> manager
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Disposable PostgreSQL test DB (user/db: finsentinel_migration_test).
# setup-wsl.sh replaces this placeholder with a random value on first run.
POSTGRES_PASSWORD=__GENERATE__

# Directory (as seen from WSL) containing finsentinel-siem.jsonl, written by
# scripts/siem_forwarder.py on Windows. Mounted read-only into the manager.
FINSENTINEL_LOGS_DIR=/mnt/d/prj 4/drift-causal-fl/finsentinel/logs
